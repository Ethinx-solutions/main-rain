# Database
MONGODB_URI=mongodb://localhost:27017/secondbrain

# JWT Secret (generate with: openssl rand -hex 32) - REQUIRED in production
JWT_SECRET=

# Email verification (choose ONE provider)
# - Resend (recommended if you have an authorised API key):
RESEND_API_KEY=
MAIL_FROM=
# - Or a classic SMTP relay:
# MAIL_PROVIDER=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# - Or MAIL_PROVIDER=none to disable email delivery entirely
#   (accounts then stay unverified until delivery is configured; there is
#   deliberately no auto-verify fallback)
# MAIL_PROVIDER=none

# Client URL(s). Comma-separated list allowed for multiple frontends.
CLIENT_URL=http://localhost:3000

# AI Second Brain
# Embeddings: ollama (default, local + free) | openai | none
EMBED_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# LLM: ollama (default, local + free) | openai | none
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b-instruct
# Optional metered OpenAI path (only if OPENAI_API_KEY is authorised)
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_LLM_MODEL=gpt-5-nano

# Ingestion / cost controls
DOC_MAX_FILE_BYTES=10485760
DOC_MAX_DOCS_PER_USER=100
DOC_MAX_CHUNKS_PER_DOC=400
AI_MAX_QUESTION_CHARS=2000
AI_DEFAULT_TOP_K=8
AI_MAX_TOP_K=20
EMBED_TIMEOUT_MS=30000
LLM_TIMEOUT_MS=120000

# Server Configuration
PORT=5000
NODE_ENV=development

# Deployment URLs (update when deploying)
PRODUCTION_URL=https://your-app.herokuapp.com
