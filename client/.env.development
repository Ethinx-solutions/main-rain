# Development-server configuration (committed so the dev host stays safe).
#
# Why these are set:
# - HOST=localhost keeps the webpack-dev-server host check enabled (never set
#   DANGEROUSLY_DISABLE_HOST_CHECK=true; it is a DNS-rebinding risk and is
#   forbidden in this project).
# - PORT=3050 because this EthinX box already runs another app on 3000.
# - BROWSER=none avoids auto-opening a browser on a headless server.
HOST=localhost
PORT=3050
BROWSER=none
