{
  "name": "second-brain-dashboard",
  "version": "1.0.0",
  "description": "A comprehensive second brain app with notes, tasks, links, and daily views",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch --forceExit",
    "e2e": "node scripts/e2e-verify.js",
    "install-all": "npm install && cd client && npm install"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testTimeout": 180000,
    "verbose": true
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.9.4",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "pdfkit": "^0.15.2",
    "smtp-server": "^3.21.4",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
